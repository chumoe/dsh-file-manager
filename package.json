{
  "name": "dsh-file-manager",
  "version": "1.5.1",
  "description": "Full workspace file manager for the DSH right Sidebar: browse, preview, edit, create, rename, copy, move, delete, compress, extract, upload, download, and add files to the chat with real reference chips.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "file-manager",
    "file-explorer",
    "sidebar",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chumoe/dsh-file-manager.git"
  },
  "bugs": {
    "url": "https://github.com/chumoe/dsh-file-manager/issues"
  },
  "homepage": "https://github.com/chumoe/dsh-file-manager#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-files",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
